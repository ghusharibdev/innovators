# ----------------------------------------------------------------
# Local development (SQLite)
# ----------------------------------------------------------------
# DATABASE_URL="file:./dev.db"
# DIRECT_URL="file:./dev.db"

# ----------------------------------------------------------------
# Production (Neon PostgreSQL)
# ----------------------------------------------------------------
# Copy both strings from your Neon project dashboard.
# DATABASE_URL is the POOLED string (hostname contains "-pooler").
# DIRECT_URL is the DIRECT string (no "-pooler").
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# ----------------------------------------------------------------
# Auth
# ----------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-32-plus-character-random-string"

# ----------------------------------------------------------------
# AI (Google Gemini — free tier)
# Get a key at https://aistudio.google.com/apikey
# ----------------------------------------------------------------
GEMINI_API_KEY="your-google-ai-studio-key"
GEMINI_MODEL="gemini-3.1-flash-lite"

# ----------------------------------------------------------------
# App
# ----------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="NovaWorks CRM"