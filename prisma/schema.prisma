// NovaWorks CRM data model — DESIGN.md §5
// ⚠️ change provider to "postgresql" when deploying (SQLite does not persist on serverless).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  AGENT
}

model User {
  id             String   @id @default(cuid())
  code           String   @unique // "ADMIN" | "PM01" | "DEV01" ...
  name           String
  email          String   @unique
  passwordHash   String
  role           Role
  specialization String
  skills         String // comma-separated; keep simple
  createdAt      DateTime @default(now())

  managedProjects Project[] @relation("ProjectManager")
  assignedTasks   Task[]    @relation("TaskAssignee")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  clientName  String
  description String   @default("")
  managerId   String
  deadline    DateTime
  createdAt   DateTime @default(now())

  manager User   @relation("ProjectManager", fields: [managerId], references: [id])
  tasks   Task[]

  @@index([managerId])
}

model Task {
  id             String   @id @default(cuid())
  projectId      String
  title          String
  description    String   @default("")
  assigneeId     String
  deadline       DateTime
  estimatedHours Int
  createdAt      DateTime @default(now())

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User    @relation("TaskAssignee", fields: [assigneeId], references: [id])

  @@index([projectId])
  @@index([assigneeId])
}

